{
  "components": {
    "schemas": {
      "AmoLeadCreateSchema": {
        "additionalProperties": false,
        "properties": {
          "amo_lead_id": {
            "title": "Amo Lead Id",
            "type": "integer"
          },
          "budget": {
            "minimum": 0,
            "title": "Budget",
            "type": "number"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "status_id": {
            "title": "Status Id",
            "type": "integer"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          }
        },
        "required": [
          "amo_lead_id",
          "name",
          "budget",
          "status_id",
          "created_at"
        ],
        "title": "AmoLeadCreateSchema",
        "type": "object"
      },
      "ErrorShape": {
        "properties": {
          "how_to_fix": {
            "title": "How To Fix",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "severity": {
            "title": "Severity",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "message",
          "severity",
          "location",
          "how_to_fix"
        ],
        "title": "ErrorShape",
        "type": "object"
      },
      "OneCCounterpartySchema": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Email"
          },
          "inn": {
            "pattern": "^([0-9]{10}|[0-9]{12})$",
            "title": "Inn",
            "type": "string"
          },
          "legal_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Legal Name"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Phone"
          }
        },
        "required": [
          "inn",
          "name"
        ],
        "title": "OneCCounterpartySchema",
        "type": "object"
      },
      "OneCOrderCreateSchema": {
        "additionalProperties": false,
        "properties": {
          "counterparty_ref": {
            "minLength": 1,
            "title": "Counterparty Ref",
            "type": "string"
          },
          "date": {
            "format": "date-time",
            "title": "Date",
            "type": "string"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OneCOrderItem"
            },
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "number": {
            "minLength": 1,
            "title": "Number",
            "type": "string"
          },
          "total": {
            "minimum": 0,
            "title": "Total",
            "type": "number"
          }
        },
        "required": [
          "number",
          "date",
          "counterparty_ref",
          "items",
          "total"
        ],
        "title": "OneCOrderCreateSchema",
        "type": "object"
      },
      "OneCOrderItem": {
        "additionalProperties": false,
        "properties": {
          "price": {
            "minimum": 0,
            "title": "Price",
            "type": "number"
          },
          "quantity": {
            "exclusiveMinimum": 0,
            "title": "Quantity",
            "type": "integer"
          },
          "sku": {
            "minLength": 1,
            "title": "Sku",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "quantity",
          "price"
        ],
        "title": "OneCOrderItem",
        "type": "object"
      },
      "WebhookPayload": {
        "additionalProperties": false,
        "properties": {
          "data": {
            "additionalProperties": true,
            "title": "Data",
            "type": "object"
          },
          "event_type": {
            "minLength": 1,
            "title": "Event Type",
            "type": "string"
          },
          "idempotency_key": {
            "minLength": 1,
            "title": "Idempotency Key",
            "type": "string"
          },
          "nonce": {
            "minLength": 1,
            "title": "Nonce",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          }
        },
        "required": [
          "idempotency_key",
          "event_type",
          "occurred_at",
          "nonce",
          "data"
        ],
        "title": "WebhookPayload",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Resilient AmoCRM -> 1C integration gateway (Ingress -> Validate -> Store -> Egress).",
    "title": "amocrm-1c-resilient-gateway",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Check Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check"
      }
    },
    "/webhook/amocrm": {
      "post": {
        "operationId": "amocrm_webhook_webhook_amocrm_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Event accepted (or duplicate)"
          },
          "401": {
            "description": "Invalid HMAC-SHA256 signature"
          },
          "403": {
            "description": "Replay detected or header tampering"
          },
          "422": {
            "description": "Payload validation error"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "summary": "Amocrm Webhook"
      }
    }
  }
}
